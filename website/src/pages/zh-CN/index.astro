---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Home from '../../components/Home.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { url } from '../../lib/site';
---

<BaseLayout
  lang="zh-CN"
  title="Native Shell — AI 生成的界面，原生地运行在你的应用里"
  description="Native Shell：为 AI 生成界面而设计。支持 iOS、Android 和 Linux，macOS 与 Windows 支持正在开发中。应用在运行时加载经签名的 TSX 模块，并用平台原生视图渲染。"
  alternates={{ en: '/', 'zh-CN': '/zh-CN' }}
>
  <Nav lang="zh-CN" currentPath={Astro.url.pathname} langHref={url('')} />
  <Home lang="zh-CN" />
  <SiteFooter lang="zh-CN" />
</BaseLayout>
