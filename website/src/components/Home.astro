            <p>{u.body}</p>
            <pre class="use__code"><code set:html={snippets[u.code]} /></pre>
            <ul class="use__checks">{u.checks.map((c) => <li><Fragment set:html={icon('check', 13)} />{c}</li>)}</ul>
            <a class="use__cta" href={link(u.href)}>{u.cta}<Fragment set:html={icon('arrow', 14)} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works ---------------------------------------------------- -->
  <section class="band band--tinted">
    <div class="band__inner">
      <header class="section-head">
        <span class="kicker">{copy.howKicker}</span>
        <h2>{copy.howTitle}</h2>
        <p>{copy.howLead}</p>
      </header>
      <div class="diagram">
        <img class="diagram--light" src={`${BASE}diagrams/ai-flow-light.svg`} alt={copy.howTitle} loading="lazy" />
        <img class="diagram--dark" src={`${BASE}diagrams/ai-flow-dark.svg`} alt={copy.howTitle} loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Platforms ------------------------------------------------------- -->
  <section class="band">
    <div class="band__inner platforms-band">
      <header class="section-head section-head--side">
        <span class="kicker">{copy.platKicker}</span>
        <h2>{copy.platTitle}</h2>
