    </div>
  </section>
</main>

<script>
  // The hero's story: the question, the assistant thinking, the module being
  // generated, then the live module. Played once; Replay restarts it. The
  // module appears when both the story and its frame are ready.
  const MIN_STORY_MS = 3200;
  for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
    const frame = stage.querySelector<HTMLIFrameElement>('[data-module]');
    let loaded = !frame;
    let timer = 0;
    const reveal = () => stage.classList.add('is-live');
    const play = () => {
      stage.classList.remove('is-playing', 'is-live');
      void stage.offsetWidth;
      stage.classList.add('is-playing');
      clearTimeout(timer);
      const started = performance.now();
      const check = () => {
        if (loaded && performance.now() - started >= MIN_STORY_MS) reveal();
        else timer = window.setTimeout(check, 120);
      };
      check();
    };
    frame?.addEventListener('load', () => {
      // The page loads first; the WebAssembly runtime needs a moment more.
      window.setTimeout(() => (loaded = true), 900);
    });
    stage.querySelector('[data-replay]')?.addEventListener('click', () => {
      if (frame) frame.src = frame.src;
      loaded = !frame;
      play();
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      stage.classList.add('is-playing');
      loaded = true;
      reveal();
    } else {
      play();
    }
  }
</script>

