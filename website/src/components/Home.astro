  .use__cta:hover { text-decoration: underline; text-underline-offset: 3px; }
  :global(.c-k) { color: var(--code-keyword); }
  :global(.c-s) { color: var(--code-string); }
  :global(.c-f) { color: var(--code-fn); }
  :global(.c-t) { color: var(--code-type); }
  :global(.c-c) { color: var(--code-comment); }

  /* How it works */
  .diagram { padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-surface); background: var(--background); }
  .diagram img { display: block; width: 100%; height: auto; }
