---
// The landing page. Structure and rules follow gpui-kit.com (DESIGN.md):
// one container per band, hairline separators, restraint, verifiable
// specifics. The hero shows what nsh is for: a native host app whose
// assistant answers with a generated module, running live in the marked
// region (the WebAssembly preview of demos/home-module.tsx).
import { BASE, url, type Lang } from '../lib/site';
import { hasPlayer } from '../lib/demo.js';

export interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh-CN';
const link = (path: string) => url(zh ? `zh-CN/${path}` : path);
const player = hasPlayer();
const moduleSrc = `${BASE}play/index.html?theme=light#home-module`;

const copy = zh
  ? {
      eyebrow: '为 AI 生成界面而设计',
      title: ['AI 生成的界面，', '原生地运行在你的应用里。'],
      lead: 'native-shell 嵌入 iOS 和 Android 应用，在运行时加载用 TSX 编写的模块——由模型或你的团队编写——经过签名校验，运行在宿主配置的沙箱里，并用真正的 UIKit 与 Android 视图渲染。无需发版。',
      start: '阅读简介',
      try: '在线试用',
      meta: [
        ['phone', 'iOS · Android；桌面端（GPUI）开发中'],
        ['scale', '开源 · MIT 或 Apache-2.0'],
        ['building', '由长桥（Longbridge）构建'],
      ],
      snippetLang: 'Swift',
      host: {
        title: '助手',
        ask: '英伟达和苹果这周表现怎么样？',
        reply: '这是两者的对比，可以切换时间范围：',
        steps: ['已编译', '签名已校验', '已进入沙箱'],
        generating: '正在生成模块',
        input: '问点什么…',
        tag: 'nsh 模块',
      },
      legendHost: '原生应用：宿主自己的 UIKit / Android 代码',
      legendModule: 'nsh 模块：生成的 TSX，在沙箱中运行（此处为 Web 预览）',
      replay: '重播',
      capKicker: 'AI 友好',
      capTitle: '为模型编写、为宿主把关而设计。',
      capLead: '生成的界面要好写、可验证、跑得安全，还要是真正的原生界面。nsh 的每一层都围绕这四点设计。',
      usesKicker: '三种用法',
      usesTitle: '同一个模块，三种用法。',
      usesLead: '首要用途是 AI 生成的界面；同一套机制也让原生应用可以扩展，或者直接组成一个独立应用。',
      howKicker: '工作原理',
      howTitle: '在服务器上生成，在设备上被信任。',
      howLead: '服务器负责生成、检查和签名；设备负责校验、隔离和渲染。信任边界清清楚楚。',
      platKicker: '平台',
      platTitle: '先手机，再桌面。',
      principleKicker: '原则',
      principle: ['模型负责编写界面。', '宿主决定它能做什么。'],
      principleBody: '模块只能看到宿主授予的能力，只占用宿主允许的资源，只在签名校验通过后运行。剩下的——文本、输入、无障碍、动画——交给系统的原生视图。',
      principleCta: '在线试用',
    }
  : {
      eyebrow: 'Built for AI-generated UI',
      title: ['AI-generated UI,', 'native in your app.'],
      lead: 'native-shell embeds in iOS and Android apps and loads modules written in TSX — by a model or by your team — at run time: signature-checked, sandboxed by rules the host sets, and drawn with real UIKit and Android views. No app release.',
      start: 'Read the introduction',
      try: 'Try the playground',
      meta: [
        ['phone', 'iOS · Android; desktop (GPUI) in development'],
        ['scale', 'Open source · MIT or Apache-2.0'],
        ['building', 'Built at Longbridge'],
      ],
      snippetLang: 'Swift',
      host: {
        title: 'Assistant',
        ask: 'How did NVDA and AAPL do this week?',
        reply: 'Here’s how they compare. Switch the range to see more:',
        steps: ['Compiled', 'Signature verified', 'Sandboxed'],
        generating: 'Generating module',
        input: 'Ask anything…',
        tag: 'nsh module',
      },
      legendHost: 'Native app: the host’s own UIKit / Android code',
      legendModule: 'nsh module: generated TSX in a sandbox (web preview here)',
      replay: 'Replay',
      capKicker: 'AI friendly',
      capTitle: 'Designed for models to write and hosts to trust.',
      capLead: 'Generated UI has to be easy to write, checkable, safe to run and truly native. Every layer of nsh is built around those four.',
      usesKicker: 'Three uses',
      usesTitle: 'One module, three ways to use it.',
      usesLead: 'AI-generated UI is what nsh is designed for. The same mechanism makes native apps extensible, or becomes a whole app.',
      howKicker: 'How it works',
      howTitle: 'Generated on the server, trusted on the device.',
      howLead: 'The server generates, checks and signs; the device verifies, confines and renders. The trust boundary stays explicit.',
      platKicker: 'Platforms',
      platTitle: 'Phones first, then desktop.',
      principleKicker: 'Principle',
      principle: ['Models write the interface.', 'The host decides what it may do.'],
      principleBody: 'A module sees only the capabilities the host grants, uses only the resources it allows, and runs only after its signature checks out. Everything else — text, input, accessibility, animation — belongs to the system’s native views.',
      principleCta: 'Try the playground',
    };

const caps = zh
  ? [
      { id: 'tsx', icon: 'file', title: '模型擅长的格式', body: '一个模块就是一个 TSX 文件：信号、少量宿主元素和 Tailwind 类。没有构建配置，没有 node_modules。', chips: ['TSX', 'signal()', 'class'] },
      { id: 'types', icon: 'braces', title: '精确的生成式契约', body: '每个元素、属性和模块都有从 Rust 源码生成的 TypeScript 声明，文档也以 llms.txt 提供给模型。', chips: ['.nsh/types', 'llms.txt'] },
      { id: 'check', icon: 'check', title: '无需设备即可验证', body: 'nsh trace 无界面地运行模块并报告错误；编译器还能在进程内或浏览器里运行。生成、检查、重试。', chips: ['nsh trace', 'compile_module'] },
      { id: 'sandbox', icon: 'lock', title: '不可信，也能安全运行', body: '每个视图一个 QuickJS 虚拟机，内存、调用时长和节点数都有上限，只能使用宿主授予的能力。', chips: ['NshLimits', 'grantCapabilities'] },
      { id: 'signed', icon: 'shield', title: '签名下发，可吊销', body: '模块以 Ed25519 签名的 .nshpkg 到达；发布密钥由离线根密钥认证，设备端检查吊销列表。', chips: ['nsh publish', 'NshTrust'] },
      { id: 'native', icon: 'phone', title: '真正的原生视图', body: '模块由 UIKit 与 Android 视图组成：系统的文本选区、拷贝与翻译菜单、输入法和无障碍都原样可用。', chips: ['UIView', 'android.view.View'] },
    ]
  : [
      { id: 'tsx', icon: 'file', title: 'A format models write well', body: 'A module is one TSX file: signals, a few host elements and Tailwind classes. No build configuration, no node_modules.', chips: ['TSX', 'signal()', 'class'] },
      { id: 'types', icon: 'braces', title: 'An exact, generated contract', body: 'Every element, prop and module has TypeScript declarations generated from the Rust sources; the docs are served to models as llms.txt.', chips: ['.nsh/types', 'llms.txt'] },
      { id: 'check', icon: 'check', title: 'Checked without a device', body: 'nsh trace runs a module headless and reports errors; the compiler also runs in-process or in a browser. Generate, check, retry.', chips: ['nsh trace', 'compile_module'] },
      { id: 'sandbox', icon: 'lock', title: 'Untrusted, and contained', body: 'One QuickJS VM per view, with memory, call-time and node limits, reaching only the capabilities the host grants.', chips: ['NshLimits', 'grantCapabilities'] },
      { id: 'signed', icon: 'shield', title: 'Signed, revocable delivery', body: 'Modules arrive as Ed25519-signed .nshpkg files; release keys are certified by an offline root and revocations are checked on device.', chips: ['nsh publish', 'NshTrust'] },
      { id: 'native', icon: 'phone', title: 'Real native views', body: 'Modules are made of UIKit and Android views, so the system’s text selection, Copy and Translate menu, input and accessibility just work.', chips: ['UIView', 'android.view.View'] },
    ];

const uses = zh
  ? [
      { tag: '设计初衷', label: 'AI 生成的界面', title: '用界面而不是文字回答', body: '模型为每次请求写一个模块，服务器检查并签名，应用在沙箱里原生地显示它。', code: 'ai', checks: ['每个回答一个 TSX 文件', '下发前完成类型检查与 trace', '只拥有宿主授予的能力'], cta: '为什么做 nsh', href: 'docs' },
      { tag: '', label: '原生应用插件', title: '发布之后再扩展应用', body: '在任意页面嵌入 NshAppView 或 NshView，承载团队、合作方或用户之后编写的功能。', code: 'host', checks: ['一个页面可以放多个模块', '宿主注册自己的原生组件', '更新无需发版与审核'], cta: '在 iOS 应用中嵌入', href: 'docs/embedding-ios' },
      { tag: '', label: '独立应用', title: '也能组成完整的应用', body: '同样的模块可以用 nsh package 打成可安装的 iOS 或 Android 应用，适合试用和小工具。', code: 'app', checks: ['使用预编译的运行时', '不需要 Xcode 工程或 Gradle', '保存即热更新开发'], cta: '打包', href: 'docs/packaging' },
    ]
  : [
      { tag: 'Designed for', label: 'AI-generated UI', title: 'Answer with an interface', body: 'A model writes a module per request, your server checks and signs it, and the app shows it natively, in a sandbox.', code: 'ai', checks: ['One TSX file per answer', 'Type-checked and traced before it ships', 'Only the capabilities the host grants'], cta: 'Why nsh exists', href: 'docs' },
      { tag: '', label: 'Plugins for native apps', title: 'Extend the app after release', body: 'Embed an NshAppView or NshView on any screen and host features your team, partners or users write later.', code: 'host', checks: ['Several modules on one screen', 'The host’s own native components', 'Updates without a release or review'], cta: 'Embedding in iOS apps', href: 'docs/embedding-ios' },
      { tag: '', label: 'Standalone apps', title: 'Or a whole app', body: 'The same modules can become an installable iOS or Android app with nsh package — for trying nsh and for small tools.', code: 'app', checks: ['The prebuilt runtime', 'No Xcode project or Gradle build', 'Hot reload while you develop'], cta: 'Packaging', href: 'docs/packaging' },
    ];

const platforms = zh
  ? [
      { name: 'iOS', detail: 'UIKit · iOS 15+', status: '已支持', kind: 'ok' },
      { name: 'Android', detail: 'Android View · API 28+', status: '已支持', kind: 'ok' },
      { name: '桌面', detail: 'GPUI 后端', status: '开发中', kind: 'wip' },
      { name: 'Web', detail: 'WebAssembly → DOM', status: '仅用于演示', kind: 'demo' },
    ]
  : [
      { name: 'iOS', detail: 'UIKit · iOS 15+', status: 'Supported', kind: 'ok' },
      { name: 'Android', detail: 'Android View · API 28+', status: 'Supported', kind: 'ok' },
      { name: 'Desktop', detail: 'GPUI backend', status: 'In development', kind: 'wip' },
      { name: 'Web', detail: 'WebAssembly → DOM', status: 'Demos only', kind: 'demo' },
    ];

// Hand-colored snippets: real API, coloured with the site's code tokens.
const k = (s: string) => `<span class="c-k">${s}</span>`;
const st = (s: string) => `<span class="c-s">${s}</span>`;
const fn = (s: string) => `<span class="c-f">${s}</span>`;
const cm = (s: string) => `<span class="c-c">${s}</span>`;
const ty = (s: string) => `<span class="c-t">${s}</span>`;
const snippets: Record<string, string> = {
  ai: [
    `${k('import')} { mount, signal } ${k('from')} ${st('"nsh"')};`,
    ``,
    `${k('function')} ${fn('Answer')}() {`,
    `  ${k('const')} range = ${fn('signal')}(${st('"1W"')});`,
    `  ${k('return')} &lt;${ty('view')} class=${st('"gap-3 p-4"')}&gt;…&lt;/${ty('view')}&gt;;`,
    `}`,
    `${fn('mount')}(Answer);`,
  ].join('\n'),
  host: [
    `${k('let')} app = ${ty('NshAppView')}()`,
    `${k('try')} app.${fn('grantCapabilities')}(grants)`,
    `${k('let')} info = ${k('try await')} app`,
    `  .${fn('loadPackage')}(at: file, trust: trust)`,
    `${cm('// verified, sandboxed, running')}`,
  ].join('\n'),
  app: [
    `${cm('$')} nsh init my-app`,
    `${cm('$')} nsh run my-app`,
    `${cm('$')} nsh package my-app --target ios`,
    `${cm('$')} nsh package my-app --target android`,
  ].join('\n'),
};
const heroSnippet = `${k('try await')} app.${fn('loadPackage')}(at: url, trust: trust)`;

const icons: Record<string, string> = {
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9.5 13l-2 2 2 2M14.5 13l2 2-2 2"/>',
  braces: '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1M16 21h1a2 2 0 0 0 2-2v-5a2 2 0 0 1 2-2 2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/>',
  check: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  phone: '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10.5 18.5h3"/>',
  scale: '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1ZM2 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1ZM7 21h10M12 3v18M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  building: '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  spark: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/>',
};
const icon = (name: string, size = 16) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
---

<main class="home" id="main">
  <!-- Hero ------------------------------------------------------------ -->
  <section class="hero">
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="band__inner hero__inner">
      <div class="hero__copy rise">
        <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>{copy.eyebrow}</span>
        <h1>{copy.title[0]}<br />{copy.title[1]}</h1>
        <p class="hero__lead">{copy.lead}</p>
        <div class="hero__actions">
          <a href={link('docs')} class="btn btn--primary">{copy.start}<Fragment set:html={icon('arrow')} /></a>
          <a href={link('playground')} class="btn">{copy.try}</a>
        </div>
        <ul class="hero__meta">
          {copy.meta.map(([i, text]) => <li><Fragment set:html={icon(i, 14)} />{text}</li>)}
        </ul>
        <div class="hero__snippet"><span>{copy.snippetLang}</span><code set:html={heroSnippet} /></div>
      </div>

      <figure class="stage rise rise--2" data-stage>
        <div class="device">
          <div class="device__screen">
            <div class="host__status" aria-hidden="true">
              <span>9:41</span>
              <span class="host__status-icons">
                <svg viewBox="0 0 18 12" width="17" height="11"><path fill="currentColor" d="M1 8h2v3H1zM5 6h2v5H5zM9 4h2v7H9zM13 1h2v10h-2z"/></svg>
                <svg viewBox="0 0 16 12" width="15" height="11"><path fill="currentColor" d="M8 11.2 5.6 8.8a3.4 3.4 0 0 1 4.8 0zM3.5 6.7a6.4 6.4 0 0 1 9 0l-1.4 1.4a4.4 4.4 0 0 0-6.2 0zM1.3 4.5a9.5 9.5 0 0 1 13.4 0l-1.4 1.4a7.5 7.5 0 0 0-10.6 0z"/></svg>
                <svg viewBox="0 0 26 12" width="24" height="11"><rect x="0.5" y="0.5" width="21" height="11" rx="3" fill="none" stroke="currentColor" opacity=".45"/><rect x="2" y="2" width="16" height="8" rx="1.6" fill="currentColor"/><path d="M23 4v4" stroke="currentColor" opacity=".45" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </div>
            <div class="host__nav">
              <span class="host__avatar" set:html={icon('spark', 14)} />
              <span class="host__title">{copy.host.title}</span>
            </div>
            <div class="host__chat">
              <div class="bubble bubble--me step step--1">{copy.host.ask}</div>
              <div class="host__reply step step--2">
                <span class="host__reply-avatar" set:html={icon('spark', 12)} />
                <span class="typing" aria-hidden="true"><i></i><i></i><i></i></span>
                <p class="host__reply-text">{copy.host.reply}</p>
              </div>
              <div class="module step step--3">
                <span class="module__tag"><span class="module__tag-dot"></span>{copy.host.tag}</span>
                <div class="module__frame">
                  <div class="module__pending" aria-hidden="true">
                    <div class="module__pending-head"><span class="spinner"></span>{copy.host.generating}</div>
                    <ul class="module__steps">
                      {copy.host.steps.map((s, i) => <li style={`--i:${i}`}><span class="tick" set:html={icon('check', 12)} />{s}</li>)}
                    </ul>
                    <div class="skeleton"><i></i><i></i><i class="skeleton__chart"></i></div>
                  </div>
                  {player
                    ? <iframe data-module src={moduleSrc} title={copy.host.tag} loading="eager" tabindex="-1"></iframe>
                    : null}
                </div>
              </div>
            </div>
            <div class="host__input" aria-hidden="true">
              <span>{copy.host.input}</span>
              <span class="host__send" set:html={icon('arrow', 13)} />
            </div>
            <div class="host__home" aria-hidden="true"></div>
          </div>
        </div>
        <figcaption class="legend">
          <span><i class="legend__swatch legend__swatch--host"></i>{copy.legendHost}</span>
          <span><i class="legend__swatch legend__swatch--module"></i>{copy.legendModule}</span>
          <button type="button" class="legend__replay" data-replay>{copy.replay}</button>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- AI friendly ----------------------------------------------------- -->
  <section class="band">
    <div class="band__inner">
      <header class="section-head">
        <span class="kicker">{copy.capKicker}</span>
        <h2>{copy.capTitle}</h2>
        <p>{copy.capLead}</p>
      </header>
      <div class="caps">
        {caps.map((c) => (
          <article class="cap">
            <h3><Fragment set:html={icon(c.icon)} />{c.title}</h3>
            <p>{c.body}</p>
            <ul class="chips">{c.chips.map((x) => <li>{x}</li>)}</ul>
            <div class={`mini mini--${c.id}`} aria-hidden="true">
              {c.id === 'tsx' && (
                <div class="mini-code">
                  <span class="mini-file">answer.tsx</span>
                  <i style="--w:46%;--c:var(--code-keyword)"></i>
                  <i style="--w:28%;--c:var(--code-fn);--x:12px"></i>
                  <i style="--w:62%;--c:var(--code-string);--x:24px"></i>
                  <i style="--w:38%;--c:var(--code-type);--x:24px"></i>
                  <i style="--w:20%;--c:var(--code-fn);--x:12px"></i>
                </div>
              )}
              {c.id === 'types' && (
                <pre class="mini-dts"><span class="c-k">interface</span> <span class="c-t">ButtonProps</span> {'{'}
  title: <span class="c-t">string</span>;
  variant?: <span class="c-s">"primary"</span> | <span class="c-s">"plain"</span>;
  onPress?: () =&gt; <span class="c-t">void</span>;
{'}'}</pre>
              )}
              {c.id === 'check' && (
                <ul class="mini-checks">
                  <li><span set:html={icon('check', 12)} /><code>build</code><i style="--w:72%"></i></li>
                  <li><span set:html={icon('check', 12)} /><code>trace</code><i style="--w:88%"></i></li>
                  <li><span set:html={icon('check', 12)} /><code>tap</code><i style="--w:54%"></i></li>
                </ul>
              )}
              {c.id === 'sandbox' && (
                <div class="mini-sandbox">
                  <div class="meters">
                    <span><code>memory</code><i style="--w:38%"></i></span>
                    <span><code>call</code><i style="--w:16%"></i></span>
                    <span><code>nodes</code><i style="--w:24%"></i></span>
                  </div>
                  <div class="grants">
                    <span class="grant grant--ok">api.example.com</span>
                    <span class="grant grant--no">statusBar</span>
                  </div>
                </div>
              )}
              {c.id === 'signed' && (
                <div class="mini-signed">
                  <span class="node">.nshpkg</span>
                  <span class="dash"></span>
                  <span class="node node--key">Ed25519</span>
                  <span class="dash"></span>
                  <span class="node node--ok"><Fragment set:html={icon('shield', 13)} />verified</span>
                </div>
              )}
              {c.id === 'native' && (
                <div class="mini-native">
                  <div class="menu">
                    {(zh ? ['拷贝', '分享', '翻译', '查询'] : ['Copy', 'Share', 'Translate', 'Look Up']).map((m) => <span>{m}</span>)}
                  </div>
                  <p>{zh ? <>英伟达本周上涨 <mark>8.6%</mark>，苹果 4.4%</> : <>NVDA gained <mark>8.6% this week</mark>, AAPL 4.4%</>}</p>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Three uses ------------------------------------------------------ -->
  <section class="band">
    <div class="band__inner">
      <header class="section-head">
        <span class="kicker">{copy.usesKicker}</span>
        <h2>{copy.usesTitle}</h2>
        <p>{copy.usesLead}</p>
      </header>
      <div class="uses">
        {uses.map((u, i) => (
          <article class:list={['use', { 'use--primary': i === 0 }]}>
            <div class="use__label">
              <span>{u.label}</span>
